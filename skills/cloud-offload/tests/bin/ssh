#!/usr/bin/env python3
"""Fake `ssh`. Logs argv and the stdin script to $OFFLOAD_FAKE_LOG, replies from
$OFFLOAD_FAKE_SSH_OUT (stdout) and exits with $OFFLOAD_FAKE_SSH_RC (default 0).
If OFFLOAD_FAKE_SSH_OUT is unset, replies are inferred from the script's markers."""
import json
import os
import sys

script = sys.stdin.read() if not sys.stdin.isatty() else ""
with open(os.environ["OFFLOAD_FAKE_LOG"], "a") as f:
    f.write(json.dumps(["ssh", *sys.argv[1:], {"stdin": script}]) + "\n")

rc = int(os.environ.get("OFFLOAD_FAKE_SSH_RC", "0"))
if rc:
    sys.stderr.write("ssh: connect to host timed out\n")
    sys.exit(rc)

if "OFFLOAD_FAKE_SSH_OUT" in os.environ:
    sys.stdout.write(os.environ["OFFLOAD_FAKE_SSH_OUT"])
elif "echo started" in script:
    print("started")
elif 'echo "found=yes"' in script:
    state = os.environ.get("OFFLOAD_FAKE_JOB_STATE", "running")
    print("found=yes\nstarted=2026-01-01T00:00:00Z")
    print("state=exited\nexit=0" if state == "exited" else "state=running")
    print("stdout_bytes=12\nstderr_bytes=0\nout_files=1\nout_bytes=99\nnow=2026-01-01T00:01:00Z")
elif "tail -n" in script:
    sep = [w for w in script.split() if w.startswith("OFFLOAD_SEP_")][0].rstrip(";")
    print(f"hello world\n{sep}\nsome warning")
sys.exit(0)
