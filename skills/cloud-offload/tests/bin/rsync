#!/usr/bin/env python3
"""Fake `rsync`: logs argv, drops a file into the destination directory."""
import json
import os
import sys

with open(os.environ["OFFLOAD_FAKE_LOG"], "a") as f:
    f.write(json.dumps(["rsync", *sys.argv[1:]]) + "\n")
dest = sys.argv[-1]
os.makedirs(dest, exist_ok=True)
with open(os.path.join(dest, "result.txt"), "w") as f:
    f.write("fetched\n")
